# Copy this file to .env and replace every active "replace-me" value.
# Never commit .env.

# ---------------------------------------------------------------------------
# Required identity
# ---------------------------------------------------------------------------
AGENT_NAME=replace-me

# ---------------------------------------------------------------------------
# Docker Compose host settings
# ---------------------------------------------------------------------------
# Production binds to this host interface. Keep loopback unless you need direct
# tailnet access to the private dashboard. The development overlay stays on
# loopback.
HOST_BIND_IP=127.0.0.1
HOST_PORT=8080
RESTART_POLICY=unless-stopped
# ENV_FILE=.env
# IMAGE=blacki:local

# Model Configuration
# This sample activates OpenRouter. Use an explicit provider/model identifier.
ROOT_AGENT_MODEL=openrouter/google/gemini-2.5-flash
# Optional OpenRouter fallback: max, xhigh, high, medium, low, minimal, or none.
# ROOT_AGENT_REASONING_EFFORT=max

# Activate exactly one provider for the first deployment.
OPENROUTER_API_KEY=replace-me
#
# Google AI Studio alternative:
# 1. Comment out OPENROUTER_API_KEY above.
# 2. Set ROOT_AGENT_MODEL=gemini-2.5-flash.
# 3. Uncomment and replace GOOGLE_API_KEY below.
# GOOGLE_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Exa Search Tool (optional, primary web search)
# Returns relevant highlights for model-agnostic agent search workflows.
# Get an API key at: https://dashboard.exa.ai/api-keys
# EXA_API_KEY=your_exa_api_key_here

# Brave Search Tool (optional fallback)
# Used when Exa is unavailable or cannot find useful results.
# Get a free API key at: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ---------------------------------------------------------------------------
# Browser Use Cloud (optional browser automation for the agent)
# ---------------------------------------------------------------------------
# Natural-language web automation (scraping, forms, navigation). Get a key at:
# https://cloud.browser-use.com — documented API: https://docs.browser-use.com/cloud/
# BROWSER_USE_API_KEY=bu_your_key_here

# Database Configuration
# SQLite database for reminders, calories, workouts, and preferences
# Default: {AGENT_DIR}/.adk/tools.db (inside container: /app/src/.adk/tools.db)
# SQLITE_PATH=./data/tools.db
# Legacy weekly-split workout tools are hidden unless explicitly enabled.
# LEGACY_WORKOUT_TOOLS_ENABLED=false

# Server Configuration
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8080

# Feature Flags
SERVE_WEB_INTERFACE=false
RELOAD_AGENTS=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
# The ADK task worker is enabled by default. Set false to opt out.
# User-scoped account tools remain root-only.
TASK_WORKER_ENABLED=true

# ---------------------------------------------------------------------------
# Telegram Bot Configuration
# ---------------------------------------------------------------------------
# Disabled in the full sample. Enable only after adding a real token.
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=replace-me
# Telegram turns automatically show one live-updating tool status message.

# Optional private text-to-speech delivery for Telegram replies. The Kokoro
# server must be reachable from the Blacki container; localhost points back to
# the container itself. A Tailscale address is appropriate for a private API.
# KOKORO_TTS_BASE_URL=http://100.x.y.z:8880
# KOKORO_TTS_VOICE=af_heart

# Optional Google Health read-only connector for private Telegram chats.
# Configure a Google Cloud OAuth web client and enable Google Health first.
# Production must use an HTTPS callback reachable by the user:
# GOOGLE_HEALTH_REDIRECT_URI=https://api.example.com/integrations/google-health/callback
# Local development may use the default http://127.0.0.1:8080 callback.
# GOOGLE_HEALTH_CLIENT_ID=replace-me
# GOOGLE_HEALTH_CLIENT_SECRET=replace-me
# Generate a Fernet key in a trusted environment and store it as a secret:
# uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY=replace-me
# GOOGLE_HEALTH_SYNC_INTERVAL_HOURS=12
# GOOGLE_HEALTH_MANUAL_REFRESH_COOLDOWN_SECONDS=3600
# GOOGLE_HEALTH_OAUTH_STATE_TTL_SECONDS=600
# The connector is called Connect Google Health because Apple Health import is
# user-configured and may only provide a subset of records to Google Health.

# To get a Telegram bot token:
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot and follow the instructions
# 3. Copy the token you receive
# See docs/telegram-setup.md for detailed instructions

# ---------------------------------------------------------------------------
# Zepto MCP (optional, one shared account)
# ---------------------------------------------------------------------------
# Authenticate first: uv run python -m blacki.zepto.auth login
# Then allow positive private Telegram chat IDs only (comma-separated).
ZEPTO_MCP_ENABLED=false
# ZEPTO_MCP_ALLOWED_TELEGRAM_CHAT_IDS=123456789
# The host and container both resolve this through the ./data volume.
# ZEPTO_MCP_CONFIG_DIR=data/credentials/zepto-mcp-remote
# See docs/zepto-mcp.md for security, OAuth, and verification details.

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Blacki always writes JSON logs and traces to ./logs. Set a trace-specific or
# global endpoint to add remote OTLP span export. Trace-specific values take
# precedence. gRPC endpoints have no path. HTTP/protobuf trace endpoints are
# complete signal URLs; global HTTP endpoints receive /v1/traces automatically.
# TELEMETRY_NAMESPACE=production
#
# gRPC:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com:4317
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=replace-me
#
# HTTP/protobuf:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20replace-me
#
# Global fallbacks:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_HEADERS=authorization=replace-me

# ---------------------------------------------------------------------------
# Mem0 Memory Integration (Optional)
# ---------------------------------------------------------------------------
# Enable persistent memory across conversations using mem0ai.
# Blacki uses Mem0 OSS directly. Do not set MEM0_API_KEY unless you are
# intentionally switching to Mem0 Platform in custom code.
#
# Production setup:
#   - OPENROUTER_API_KEY powers Mem0's LLM extraction via LiteLLM.
#   - GOOGLE_API_KEY powers Gemini embedding generation.
#   - Qdrant Cloud stores and searches the generated vectors.
#
# Qdrant does not calculate embeddings in this Mem0 flow. If you change the
# embedding model or dimensions, create a new collection and re-embed memories.
#
# LLM Configuration (uses OPENROUTER_API_KEY by default through LiteLLM)
# MEM0_LLM_PROVIDER=litellm
# MEM0_LLM_MODEL=openrouter/google/gemini-2.0-flash-001
# MEM0_LLM_API_KEY=  # Optional override; defaults to OPENROUTER_API_KEY
# MEM0_LLM_TEMPERATURE=0.1
# MEM0_LLM_MAX_TOKENS=1000
#
# Embedder Configuration (managed Gemini embeddings)
# MEM0_EMBEDDER_PROVIDER=gemini
# MEM0_EMBEDDER_MODEL=gemini-embedding-001
# MEM0_EMBEDDER_DIMS=768
# MEM0_EMBEDDER_API_KEY=  # Optional override; defaults to GOOGLE_API_KEY
#
# Memory Configuration
# MEM0_USER_ID=default
# MEM0_COLLECTION_NAME=blacki_memories_gemini_768
# MEM0_SEARCH_LIMIT=5
#
# Vector Store - Qdrant Cloud (recommended for production)
# Copy the HTTPS cluster endpoint from Qdrant Cloud > Cluster Details.
# It should look like https://xyz-example.eu-central.aws.cloud.qdrant.io,
# not just a cluster ID, collection URL, or cloud dashboard URL.
# MEM0_QDRANT_URL=https://xyz-example.eu-central.aws.cloud.qdrant.io
# MEM0_QDRANT_API_KEY=your-qdrant-cloud-api-key
#
# Vector Store - Local embedded Qdrant (development fallback)
# Used only when MEM0_QDRANT_URL and MEM0_QDRANT_API_KEY are both absent.
# MEM0_QDRANT_PATH=./data/qdrant
#
# Vector Store - Remote Server Mode (optional)
# Uncomment both to connect to your own Qdrant server instead of Qdrant Cloud:
# MEM0_QDRANT_HOST=localhost
# MEM0_QDRANT_PORT=6333

# ---------------------------------------------------------------------------
# OpenSandbox Integration (Optional)
# ---------------------------------------------------------------------------
# Enable isolated sandbox environments for code execution and shell commands.
# Requires opensandbox-server running locally or a remote OpenSandbox instance.
#
# Quick Start (local development):
#   1. Install: uv pip install opensandbox-server
#   2. Configure: uvx opensandbox-server init-config ~/.sandbox.toml --example docker
#   3. Edit port: ~/.sandbox.toml: port = 9090
#   4. Pre-pull image: docker pull opensandbox/code-interpreter:v1.0.2
#   5. Start server: uvx opensandbox-server
#
# Enable sandbox tools
# SANDBOX_ENABLED=true
#
# OpenSandbox server domain (default: localhost:9090)
# SANDBOX_DOMAIN=localhost:9090
#
# API key for production servers (optional for local dev)
# SANDBOX_API_KEY=
#
# Sandbox TTL in minutes (default: 30)
# SANDBOX_TIMEOUT_MINUTES=30
#
# Resource limits per sandbox
# SANDBOX_MEMORY_LIMIT=512Mi
# SANDBOX_CPU_LIMIT=0.5
#
# Docker image for sandboxes (default: opensandbox/code-interpreter:v1.0.2)
# SANDBOX_IMAGE=opensandbox/code-interpreter:v1.0.2
#
# Security boundary: Blacki never copies model, repository, search, Telegram, or
# application credentials into a general-purpose sandbox. SANDBOX_API_KEY is used
# only by the host-side OpenSandbox client and is not added to the sandbox process.

# ---------------------------------------------------------------------------
# Durable Telegram Attachments in Cloudflare R2 (Optional)
# ---------------------------------------------------------------------------
# Persist supported Telegram attachments for 90 days, catalog them per sender,
# and allow the Telegram root agent to restore them into a fresh sandbox.
# Use a private bucket and a bucket-scoped Object Read & Write token.
# Configure an R2 lifecycle rule for prefix blacki/user-files/ after 90 days.
# R2_FILES_ENABLED=false
# R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET_NAME=blacki-user-files
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_OWNER_HMAC_SECRET=
# R2_FILE_KEY_PREFIX=blacki/user-files
# R2_FILE_RETENTION_DAYS=90
