# Minimal, production-safe configuration for a Telegram deployment.
# Copy to .env, replace every "replace-me" value, and keep the file private.

AGENT_NAME=replace-me

# This sample uses OpenAI. See .env.example for Google AI Studio instead.
ROOT_AGENT_MODEL=gpt-6-luna
# ROOT_AGENT_REASONING_EFFORT=max
OPENAI_API_KEY=replace-me

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=replace-me

# Keep the production HTTP endpoint on VPS loopback by default. Set this to the
# VPS's Tailscale IPv4 address only when direct tailnet access is required.
HOST_BIND_IP=127.0.0.1
HOST_PORT=8080
SERVE_WEB_INTERFACE=false
RELOAD_AGENTS=false
LOG_LEVEL=DEBUG
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY

# See .env.example and the configuration reference for optional integrations.
