# Minimal, production-safe configuration for a Telegram deployment.
# Copy to .env, replace every "replace-me" value, and keep the file private.

AGENT_NAME=replace-me

# This sample uses OpenRouter. See .env.example for Google AI Studio instead.
ROOT_AGENT_MODEL=openrouter/google/gemini-2.5-flash
OPENROUTER_API_KEY=replace-me

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=replace-me

# The HTTP endpoint stays on the VPS loopback interface by default.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
SERVE_WEB_INTERFACE=false
RELOAD_AGENTS=false

# See .env.example and the configuration reference for optional integrations.
