# Health: built-in, locked.
root = Page("Health", [views], subtitle: "From your Google Health archive.")
rhr = Query("health.daily", {metric: "resting_hr", days: 60})
hrv = Query("health.daily", {metric: "hrv", days: 60})
spo2 = Query("health.daily", {metric: "spo2", days: 30})
breath = Query("health.daily", {metric: "breathing", days: 30})
body = Query("body.weighins", {days: 365})
vo2 = Query("health.daily", {metric: "vo2_max", days: 90})
sleep = Query("health.sleep", {days: 30})

views = Tabs([sleepTab, heartTab, bodyTab, vitalsTab])

sleepTab = Tab("Sleep", [sleepStats, stages, nights])
sleepStats = StatRow([avgSleep, avgDeep, avgRem])
avgSleep = Stat("Average asleep", Round(Avg(sleep.asleep) / 60, 1), unit: "h", tone: "hot")
avgDeep = Stat("Average deep", Round(Avg(sleep.deep)), unit: "min")
avgRem = Stat("Average REM", Round(Avg(sleep.rem)), unit: "min", tone: "inverse")
stages = SleepStages(nights: 14)
nights = Table(sleep, [Column("date", "Night", format: "date"), Column("bed", "Bed"), Column("wake", "Up"), Column("asleep", "Asleep", format: "minutes")], limit: 7)

heartTab = Tab("Heart", [heartStats, rhrLine, hrvBars])
heartStats = StatRow([rhrNow, rhrAvg, hrvAvg])
rhrNow = Stat("Resting heart rate", Latest(rhr.value), unit: "bpm", tone: "hot")
rhrAvg = Stat("60-day average", Round(Avg(rhr.value)), unit: "bpm")
hrvAvg = Stat("HRV, 60-day average", Round(Avg(hrv.value)), unit: "ms", tone: "inverse")
rhrLine = Line(rhr, "date", "value")
hrvBars = KeyBars(hrv, "date", "value", highlight: value >= Avg(hrv.value))

bodyTab = Tab("Body", [bodyStats, weightLine])
bodyStats = StatRow([weight, fat, fitness])
weight = Stat("Weight", Latest(body.kg), unit: "kg", tone: "hot")
fat = Stat("Body fat", Latest(body.fat), unit: "%")
fitness = Stat("VO2 max", Round(Latest(vo2.value), 1), tone: "inverse")
weightLine = Line(body, "date", "kg")

vitalsTab = Tab("Vitals", [oxygen, breathing, oxygenLine])
oxygen = RangeBar("Blood oxygen, last night", Latest(spo2.value), 85, 100, 95, 100, unit: "%")
breathing = RangeBar("Breathing rate, last night", Latest(breath.value), 8, 24, 12, 20, unit: "br/min")
oxygenLine = Line(spo2, "date", "value", min: 90, max: 100)
